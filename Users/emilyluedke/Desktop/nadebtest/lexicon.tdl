;;; -*- Mode: TDL; Coding: utf-8 -*-
;;; Nouns

tob := common-noun-lex &
  [ STEM < "tob" >,
    SYNSEM.LKEYS.KEYREL.PRED "_house_n_rel" ].

Subih := proper-noun-lex &
  [ STEM < "Subih" >,
    SYNSEM.LKEYS.KEYREL.PRED "_Subih_n_rel" ].

tih := pronoun-noun-lex &
  [ STEM < "tih" >,
    SYNSEM.LKEYS.KEYREL.PRED "_I_n_rel" ].

;;; Adjectives

;;; Verbs

ma := trans-verb-lex &
  [ STEM < "ma" >,
    SYNSEM.LKEYS.KEYREL.PRED "_make_v_rel" ].

na := intrans-verb-lex &
  [ STEM < "na" >,
    SYNSEM.LKEYS.KEYREL.PRED "_na_v_rel" ].

;;; Adverbs
